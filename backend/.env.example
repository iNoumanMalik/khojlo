# Copy to .env and adjust for your environment.
#   cp .env.example .env
# Never commit the real .env (it is git-ignored).

# ─────────────────────────── Core (required) ───────────────────────────

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=********

# JWT — generate SECRET_KEY with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=********
ACCESS_TOKEN_EXPIRE_MINUTES=********
REFRESH_TOKEN_EXPIRE_DAYS=********

# CORS — comma separated origins the Flutter app is served from
BACKEND_CORS_ORIGINS=********

# Google Sign-In — the "Web client" OAuth client ID (client_type 3) from
# frontend/android/app/google-services.json → oauth_client. Verifies the ID
# token the app sends to POST /auth/google.
GOOGLE_WEB_CLIENT_ID=********


# ─────────────────── SMTP / Email ───────────────────

SMTP_HOST=********
SMTP_PORT=********
SMTP_USERNAME=********
SMTP_PASSWORD=********
SMTP_FROM_EMAIL=********
SMTP_FROM_NAME=********
SMTP_USE_TLS=********

# Verify and Forget Password
OTP_EXPIRE_MINUTES=********
OTP_RESEND_COOLDOWN_SECONDS=********
OTP_MAX_PER_DAY=********
OTP_MAX_ATTEMPTS=********
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=********


# ───────────── Firebase / FCM push (future — optional) ─────────────

# Option A — point to the downloaded JSON file (keep it under backend/secrets/):
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
#
# Option B — inline the three fields from that JSON (keep the \n escapes in the
# private key on a single line):
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
