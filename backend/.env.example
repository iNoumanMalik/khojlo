# Copy to .env and adjust for your environment.
#   cp .env.example .env
# Never commit the real .env (it is git-ignored).

# ─────────────────────────── Core (required) ───────────────────────────

# Postgres connection. Local default below (matches docker-compose.yml); the team's shared
# Supabase URL comes privately from a teammate (see docs/team_setup.md). Write any % in the
# password as %25.
DATABASE_URL=postgresql+psycopg2://khojlo:khojlo@localhost:5432/khojlo

# JWT — generate SECRET_KEY with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS — comma separated origins the Flutter app is served from
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# Google Sign-In — the "Web client" OAuth client ID (client_type 3) from
# frontend/android/app/google-services.json → oauth_client. Verifies the ID
# token the app sends to POST /auth/google.
GOOGLE_WEB_CLIENT_ID=


# ─────────────────── SMTP / Email ───────────────────

# Leave SMTP_HOST empty to send no emails (the server logs a warning instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@khojlo.app
SMTP_FROM_NAME=Khojlo
SMTP_USE_TLS=true

# Verify and Forget Password
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_PER_DAY=5
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10


# ─────────────────── Search / filtering (Module 4) ───────────────────

# Timezone used to decide whether a business is "open now"
BUSINESS_TIMEZONE=Asia/Karachi
# Days a business keeps its "New" badge and ranking boost
NEW_BUSINESS_DAYS=30
# Largest distance filter the search API accepts (km)
SEARCH_MAX_RADIUS_KM=50


# ───────────── Push notifications: Firebase Cloud Messaging (optional) ─────────────
# Without these, push is off and everything else (including live chat) still works.
# Setup: docs/development_roadmap/module9_chat_and_push_plan.md → "Your manual steps".

# Option A (recommended) — the service account key downloaded from Firebase Console →
# Project settings → Service accounts → Generate new private key. Keep it in backend/secrets/
# (git-ignored). Get it privately from a teammate (see docs/team_setup.md); if the file isn't
# there, push is simply off:
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
#
# Option B — instead of Option A, inline the three fields from that JSON (keep the \n escapes in the private key
# on a single line):
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Maps & location (Module 6) ──
# Address lookup (address from a map pin, place search, the Home location label).
# "osm" (default): free OpenStreetMap services (Photon search, Nominatim reverse), no key.
# "google": Google Geocoding API, which needs GOOGLE_MAPS_SERVER_KEY.
GEOCODING_PROVIDER=osm
# The OSM services require an identifying User-Agent; add a contact (URL or email) for production.
GEOCODING_USER_AGENT=Khojlo/1.0 (local business discovery app)
# Public servers by default; point at self-hosted instances for heavy use.
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Server-only Google key restricted to the Geocoding API (GEOCODING_PROVIDER=google only).
GOOGLE_MAPS_SERVER_KEY=
GEOCODING_REGION=pk
GEOCODING_LANGUAGE=en
