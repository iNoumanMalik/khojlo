# Copy to .env and adjust for your environment.
#   cp .env.example .env
# Never commit the real .env (it is git-ignored).

# ─────────────────────────── Core (required) ───────────────────────────

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg2://khojlo:khojlo@localhost:5432/khojlo

# JWT — generate SECRET_KEY with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS — comma separated origins the Flutter app is served from
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000


# ─────────────────── SMTP / email (future — optional) ───────────────────
# Used later for email verification, password reset and digest emails.
# Uncomment and fill in to enable. For Gmail use an "App password"
# (Google account → Security → App passwords), NOT your normal password.
# Providers like SendGrid / Mailgun / Postmark also work.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-address@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=no-reply@khojlo.app
# SMTP_FROM_NAME=Khojlo
# SMTP_USE_TLS=true


# ───────────── Firebase / FCM push (future — optional) ─────────────
# Backend uses the Firebase Admin SDK (a service-account key) to send push
# notifications via FCM. In the Firebase console:
#   Project settings → Service accounts → Generate new private key (JSON).
# Uncomment ONE of the two options below to enable.
#
# Option A — point to the downloaded JSON file (keep it under backend/secrets/):
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
#
# Option B — inline the three fields from that JSON (keep the \n escapes in the
# private key on a single line):
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
